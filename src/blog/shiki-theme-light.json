{
  "name": "TerraConstructs Light",
  "type": "light",
  "colors": {
    "editor.foreground": "#1f2937",
    "editor.background": "#ffffff"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6b7280",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#7c3aed",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#2563eb"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#4f46e5"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#16a34a"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": {
        "foreground": "#db2777"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "entity.name.variable",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#0d9488"
      }
    },
    {
      "scope": ["meta.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#6b7280"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#9333ea"
      }
    }
  ]
}

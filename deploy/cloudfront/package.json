{
  "name": "terraconstructs-landing-cloudfront",
  "version": "1.0.0",
  "description": "TerraConstructs landing page CloudFront deployment with CSP",
  "main": "stack.js",
  "scripts": {
    "build": "tsc",
    "deploy": "npm run build && cdktf deploy",
    "destroy": "cdktf destroy",
    "synth": "npm run build && cdktf synth",
    "diff": "npm run build && cdktf diff",
    "get": "cdktf get",
    "preprocess": "node preprocess.js",
    "build-site": "npm run preprocess && npm run build"
  },
  "dependencies": {
    "cdktf": "^0.19.0",
    "constructs": "^10.3.0",
    "terraconstructs": "^0.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "cdktf",
    "terraform",
    "cloudfront",
    "terraconstructs",
    "csp"
  ],
  "author": "TerraConstructs",
  "license": "Apache-2.0"
}